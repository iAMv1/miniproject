# MindPulse Environment Configuration

# ─── Database ───
# SQLite (existing - for core behavioral data, ML features)
# Database files stored in backend/app/ml/artifacts/

# Supabase (new - for chat, wellness, extended features)
# Replace with your own project URL/key; do not commit real keys.
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
# IMPORTANT: Set via secure method (not in repo)
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Authentication ───
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, the backend uses an ephemeral random key (all sessions invalidate on restart).
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE=10080
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Register this exact backend callback URL in Google Cloud Console. It must be
# served by the backend because that origin owns the OAuth state cookie.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# The backend redirects here after it has validated Google’s response and
# issued the MindPulse access token.
FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
# Production example:
# GOOGLE_REDIRECT_URI=https://api.your-domain.example/api/v1/auth/google/callback
# FRONTEND_CALLBACK_URL=https://your-frontend.example/auth/callback

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:5000/api/v1/ws/stress
NEXT_PUBLIC_PARTYKIT_HOST=mindpulse.partykit.dev

# ─── ML / Model Artifacts ───
# Trained in the cloud (training/README.md), published as GitHub Release assets.
# When set, the backend downloads + verifies the model at startup instead of
# falling back to synthetic training.
MINDPULSE_MODEL_URL=https://github.com/iAMv1/miniproject/releases/download/model-v1-swellkw/model_xgb.joblib
MINDPULSE_STATS_URL=https://github.com/iAMv1/miniproject/releases/download/model-v1-swellkw/global_stats.joblib
# Optional: local real dataset used when (re)training locally
# MINDPULSE_REAL_DATA_CSV=app/ml/artifacts/real_dataset.csv
# Optional: label column name in MINDPULSE_REAL_DATA_CSV (default: stress_label)
# MINDPULSE_LABEL_COLUMN=stress_label

# ─── LLM Integration (Optional - graceful degradation if not set) ───
# Gemini (recommended - free tier available)
GEMINI_API_KEY=your-gemini-api-key

# Or OpenAI (fallback)
OPENAI_API_KEY=your-openai-api-key

# ─── Composio MCP Integration (Optional) ───
# For calendar, email, Slack integration
COMPOSIO_API_KEY=your-composio-api-key

# ─── Application ───
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example (Vercel frontend):
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
LOG_LEVEL=INFO
