# MindPulse Environment Configuration

# ─── Supabase (the only backend — auth, tables (RLS), edge functions) ───
# Replace with your own project URL/key; do not commit real keys.
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Frontend (inlined at build time — set in Vercel env, must match the project)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Edge function secrets (Supabase dashboard → Edge Functions → Secrets) ───
GEMINI_API_KEY=your-gemini-api-key

# ─── ML / Model Artifacts (legacy local backend only) ───
# Trained in the cloud (training/README.md), published as GitHub Release assets.
MINDPULSE_MODEL_URL=https://github.com/iAMv1/miniproject/releases/download/model-v1-swellkw/model_xgb.joblib
MINDPULSE_STATS_URL=https://github.com/iAMv1/miniproject/releases/download/model-v1-swellkw/global_stats.joblib

# ─── Application ───
ENVIRONMENT=development
LOG_LEVEL=INFO
